# Copy to /etc/ct-monitor/ct-monitor.env (install.sh does this) and edit.
# Read by systemd (EnvironmentFile), so no "export" and no shell expansion.

# Optional Cert Spotter API token (raises the rate limit): https://sslmate.com/account/api_credentials
#CERTSPOTTER_TOKEN=

# Regex of issuers you expect. Certificates from any other CA get
# ct.issuer_unexpected=true. Matched case-insensitively against the issuer's
# friendly name and its distinguished name.
#CT_ALLOWED_ISSUERS="Let's Encrypt|Google Trust Services"

# Defaults, only change if you also change the units and the Elastic Agent path:
#CT_STATE_DIR=/var/lib/ct-monitor
#CT_OUT=/var/log/ct-monitor/ct.ndjson
